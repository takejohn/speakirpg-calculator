---
import { LOCALES } from '@/scripts/locales.js';
import { useMessages } from '@/scripts/translate.js';
import { joinPath, removePrefix } from '@/scripts/utils.js';
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentPathWithoutLocalePrefix = removePrefix(
	Astro.url.pathname,
	joinPath(import.meta.env.BASE_URL, Astro.currentLocale!),
);
---

<ul class="lang-list">
{
	LOCALES.map(
		(locale) => {
			const href = getRelativeLocaleUrl(locale, currentPathWithoutLocalePrefix);
			return <li lang={locale}><a href={href}>{useMessages(locale)('$language')}</a></li>;
		}
	)
}
</ul>

<style>
.lang-list {
	display: flex;
	list-style: none;
	margin-left: auto;
	margin-right: auto;
	padding: 0;
	gap: 0.5em;
}
</style>
