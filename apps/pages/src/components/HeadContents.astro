---
import 'water.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { LOCALES } from '@/scripts/locales.js';
import { joinPath, removePrefix } from '@/scripts/utils.js';

interface Props {
	title: string;
}

const currentPathWithoutLocalePrefix = removePrefix(
	Astro.url.pathname,
	joinPath(import.meta.env.BASE_URL, Astro.currentLocale!),
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
{
	currentPathWithoutLocalePrefix != null && LOCALES.map((locale) => <link
		rel="alternate"
		hreflang={locale}
		href={getAbsoluteLocaleUrl(locale, currentPathWithoutLocalePrefix)}
	/>)
}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<title>{Astro.props.title}</title>
