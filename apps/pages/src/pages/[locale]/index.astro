---
import Layout from '@/layouts/Layout.astro';
import { useMessages } from '@/scripts/translate.js';
import { getStaticPaths, type Locale } from '@/scripts/locales.js';
import { getRelativeLocaleUrl } from 'astro:i18n';

export { getStaticPaths };

const $t = useMessages(Astro.currentLocale as Locale);
---

<Layout title={$t('$app')}>
	<h1>{$t('$app')}</h1>
	<ul>
		<li>
			<a href={getRelativeLocaleUrl(Astro.currentLocale!, '/gear-enhancement')}>
				{$t('gearEnhancement')}
			</a>
		</li>
	</ul>
</Layout>
